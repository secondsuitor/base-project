# Copy this file to .env and fill in real values.
# .env is git-ignored. Only this example file is committed.
# Keep this list in sync with the variables the project actually uses.

# Example: API key for the service the project talks to
API_KEY=your-api-key-here

# Example: runtime environment (development | production)
APP_ENV=development

# Example: log verbosity (debug | info | warning | error)
LOG_LEVEL=info
